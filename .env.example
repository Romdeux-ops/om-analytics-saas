# PostgreSQL (Supabase local ou cloud)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase — client public (frontend)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — service role (server only, jamais exposé au client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Legacy Django (conservé pendant la migration)
DJANGO_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_DJANGO_API_URL=http://127.0.0.1:8000/api
